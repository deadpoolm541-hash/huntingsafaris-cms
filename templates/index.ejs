<!DOCTYPE html>
<html class="light" lang="en">
<head>
<%- include('partials/head') %>
<style>
    @keyframes fade-in-up{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
    .animate-fade-in-up{animation:fade-in-up .8s ease forwards}
    header.scrolled{background-color:rgba(0,0,0,.2)!important;backdrop-filter:blur(8px);padding-top:.5rem!important;padding-bottom:.5rem!important;box-shadow:0 4px 20px rgba(0,0,0,.2)}
</style>
</head>
<body class="bg-background text-on-background font-body-md selection:bg-primary-fixed selection:text-primary">
<%- include('partials/header') %>
<main>
    <!-- Hero Section -->
    <section class="relative h-[calc(99dvh-72px)] lg:h-screen flex items-end overflow-hidden">
        <div class="absolute inset-0 z-0">
            <div class="w-full h-full relative bg-[#1B2B22] overflow-hidden">
                <img id="hero-blur" src="<%= page.hero.desktopBlur %>" class="absolute inset-0 w-full h-full object-cover blur-md scale-105 z-0 transition-opacity duration-700" alt=""/>
                <picture class="relative z-10">
                    <source media="(max-width: 1024px)" srcset="<%= page.hero.mobileImage %>">
                    <img id="hero-main" src="<%= page.hero.desktopImage %>" alt="<%= global.siteName %> Hero" class="w-full h-full object-cover opacity-0 transition-opacity duration-700" style="object-position:center;" onload="this.classList.remove('opacity-0'); setTimeout(() => { document.getElementById('hero-blur').classList.add('opacity-0'); }, 700);"/>
                </picture>
                <script>if(window.innerWidth<=1024){document.getElementById('hero-blur').src='<%= page.hero.mobileBlur %>';}</script>
            </div>
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#1B2B22]/80 via-[#1B2B22]/20 to-transparent pointer-events-none"></div>
        <div class="relative z-10 px-4 sm:px-8 md:px-24 pb-2 sm:pb-20 max-w-5xl">
            <span class="font-label-caps text-primary-fixed mb-2 sm:mb-4 block uppercase tracking-[0.2em] text-[10px] sm:text-label-caps opacity-0 animate-fade-in-up"><%= page.hero.tagline %></span>
            <h1 class="font-display-lg text-white text-2xl sm:text-4xl md:text-5xl mb-4 sm:mb-8 leading-tight whitespace-nowrap opacity-0 animate-fade-in-up [animation-delay:200ms]"><%= page.hero.title %></h1>
            <div class="flex gap-4 opacity-0 animate-fade-in-up [animation-delay:400ms]">
                <a href="<%= page.hero.ctaLink %>" class="bg-white text-primary px-4 sm:px-8 py-3 sm:py-4 font-label-caps flex items-center gap-2 sm:gap-3 hover:bg-primary-fixed transition-colors text-xs sm:text-label-caps">
                    <%= page.hero.ctaText %> <span class="material-symbols-outlined text-sm">north_east</span>
                </a>
            </div>
        </div>
    </section>

    <!-- Our Story Section -->
    <section class="py-16 sm:py-24 px-4 sm:px-8 md:px-margin-edge overflow-hidden">
        <div class="max-w-screen-2xl mx-auto bg-[#F5F5F5] rounded-[2.5rem] p-8 md:p-16 border border-stone-200 shadow-[0_32px_64px_-16px_rgba(0,0,0,0.1)]">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-24 items-center">
                <div class="relative order-1">
                    <div class="aspect-square rounded-[2rem] overflow-hidden shadow-2xl relative bg-stone-200">
                        <div id="story-slider" class="absolute inset-0 flex transition-transform duration-700 ease-in-out">
                            <% page.story.images.forEach(function(img, i) { %>
                            <div class="min-w-full h-full">
                                <img alt="The Hunt Experience <%= i+1 %>" class="w-full h-full object-cover" src="<%= img %>"/>
                            </div>
                            <% }); %>
                        </div>
                        <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/60 to-transparent pointer-events-none"></div>
                    </div>
                    <div id="story-dots" class="flex justify-center gap-3 mt-6"></div>
                </div>
                <div class="order-2">
                    <span class="font-label-caps text-secondary uppercase mb-6 block tracking-[0.3em]"><%= page.story.label %></span>
                    <h2 class="font-display-lg text-4xl sm:text-5xl md:text-6xl mb-8 leading-tight text-primary"><%= page.story.title %></h2>
                    <div class="space-y-6 mb-10">
                        <% page.story.paragraphs.forEach(function(p, i) { %>
                        <p class="font-body-lg text-on-surface-variant leading-relaxed<%= i===1 ? ' font-medium text-primary' : '' %>"><%= p %></p>
                        <% }); %>
                    </div>
                    <a href="contact.html" class="inline-block bg-primary-container text-white px-10 py-4 rounded-full font-label-caps uppercase tracking-widest text-sm hover:bg-primary transition-all shadow-lg hover:shadow-xl active:scale-95"><%= page.story.ctaText %></a>
                </div>
            </div>
        </div>
    </section>

    <!-- Expertise Section -->
    <section class="bg-[#1B2B22] pt-16 sm:pt-section-gap pb-0">
        <div class="pl-8 md:pl-margin-edge pr-8 md:pr-12 max-w-screen-xl mx-auto mb-16">
            <div class="text-center">
                <span class="font-label-caps text-primary-fixed uppercase mb-4 block"><%= page.expertise.label %></span>
                <h2 class="font-headline-lg text-white text-2xl sm:text-4xl md:text-headline-lg mb-4"><%= page.expertise.title %></h2>
                <p class="font-body-lg text-stone-400 max-w-2xl mx-auto"><%= page.expertise.description %></p>
                <div class="mt-10 flex justify-center">
                    <a href="services.html" class="bg-primary-container border border-white/20 text-white px-10 py-4 font-serif text-lg tracking-tight hover:bg-stone-800 transition-all active:scale-95 duration-150 inline-block"><%= page.expertise.ctaText %></a>
                </div>
            </div>
        </div>
        <div class="w-full overflow-hidden relative group">
            <img class="w-full h-auto transition-transform duration-700 group-hover:scale-105" src="<%= page.expertise.image %>" loading="lazy"/>
            <div class="absolute inset-0 bg-gradient-to-t from-[#1B2B22]/60 via-transparent to-transparent pointer-events-none"></div>
        </div>
    </section>

    <!-- Our Team -->
    <section class="py-16 sm:py-section-gap px-4 sm:px-8 md:px-margin-edge max-w-screen-xl mx-auto">
        <div class="text-center mb-10 sm:mb-16">
            <span class="font-label-caps text-secondary uppercase mb-4 block">The Experts</span>
            <h2 class="font-headline-lg text-2xl sm:text-4xl md:text-headline-lg mb-4">Our Team</h2>
            <p class="font-body-lg text-on-surface-variant max-w-2xl mx-auto">Meet the seasoned guides and professionals who lead our expeditions.</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 sm:gap-8">
            <% page.team.forEach(function(member) { %>
            <div class="group relative aspect-[3/4] overflow-hidden">
                <img alt="<%= member.name %>" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src="<%= member.image %>"/>
                <div class="absolute bottom-0 left-0 w-full bg-black/60 backdrop-blur-sm py-4 px-6">
                    <h3 class="font-headline-md text-white text-xl uppercase tracking-widest"><%= member.name %></h3>
                </div>
            </div>
            <% }); %>
        </div>
    </section>

    <!-- Join CTA -->
    <section class="py-16 sm:py-section-gap bg-surface-container-low text-center">
        <div class="px-4 sm:px-8 max-w-3xl mx-auto">
            <h2 class="font-headline-lg text-2xl sm:text-4xl md:text-headline-lg mb-6 sm:mb-8"><%= page.cta.title %></h2>
            <p class="font-body-lg text-on-surface-variant mb-10"><%= page.cta.description %></p>
            <a href="contact.html#inquiry-form" class="inline-block bg-primary text-white px-12 py-5 font-label-caps text-sm tracking-[0.2em] hover:bg-on-primary-container transition-all"><%= page.cta.buttonText %></a>
        </div>
    </section>
</main>

<%- include('partials/footer') %>

<script>
// Story slider
const slider = document.getElementById('story-slider');
const dotsContainer = document.getElementById('story-dots');
if (slider) {
    const slides = slider.children;
    let current = 0;
    for (let i = 0; i < slides.length; i++) {
        const dot = document.createElement('button');
        dot.className = 'w-3 h-3 rounded-full transition-all ' + (i === 0 ? 'bg-primary scale-110' : 'bg-stone-300');
        dot.onclick = () => { current = i; update(); };
        dotsContainer.appendChild(dot);
    }
    function update() {
        slider.style.transform = 'translateX(-' + (current * 100) + '%)';
        [...dotsContainer.children].forEach((d, i) => {
            d.className = 'w-3 h-3 rounded-full transition-all ' + (i === current ? 'bg-primary scale-110' : 'bg-stone-300');
        });
    }
    setInterval(() => { current = (current + 1) % slides.length; update(); }, 5000);
}
</script>
<%- include('partials/scripts') %>
</body>
</html>
