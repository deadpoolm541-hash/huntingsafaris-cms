                    <a href="services.html#package-nz" class="flex items-center gap-3 px-4 py-3.5 hover:bg-[#1B2B22] hover:text-white group/item transition-colors"><span class="w-1 h-1 rounded-full bg-[#1B2B22] group-hover/item:bg-white transition-colors flex-shrink-0"></span><span class="font-sans text-xs uppercase tracking-widest text-stone-600 group-hover/item:text-white transition-colors">New Zealand Beginners Package</span></a>
                    <a href="services.html#package-africa" class="flex items-center gap-3 px-4 py-3.5 hover:bg-[#1B2B22] hover:text-white group/item transition-colors border-t border-stone-100"><span class="w-1 h-1 rounded-full bg-[#1B2B22] group-hover/item:bg-white transition-colors flex-shrink-0"></span><span class="font-sans text-xs uppercase tracking-widest text-stone-600 group-hover/item:text-white transition-colors">African Hunting Experience</span></a>
