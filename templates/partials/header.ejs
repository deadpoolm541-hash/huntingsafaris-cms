<header class="fixed top-0 left-0 w-full z-50 bg-transparent transition-all duration-300">
    <div class="flex justify-between items-center w-full px-4 sm:px-8 py-3 sm:py-6 max-w-screen-2xl mx-auto transition-all duration-300" id="header-container">
        <a class="flex items-center gap-2 sm:gap-6" href="index.html">
            <img src="<%= global.logo %>" alt="Logo" class="h-8 sm:h-14 w-auto object-contain flex-shrink-0">
            <span class="font-label-caps text-white uppercase tracking-[0.1em] sm:tracking-[0.2em] text-[10px] sm:text-base whitespace-nowrap" id="logo-text"><%= global.siteName %></span>
        </a>
        <nav class="hidden xl:flex items-center gap-8 font-serif tracking-tight text-lg">
            <a class="font-serif text-lg tracking-tight <%= activePage==='home' ? 'text-white border-b-2 border-white pb-1' : 'text-white/70 hover:text-white transition-colors' %>" href="index.html">Home</a>
            <a class="font-serif text-lg tracking-tight <%= activePage==='gallery' ? 'text-white border-b-2 border-white pb-1' : 'text-white/70 hover:text-white transition-colors' %>" href="gallery.html">Photo Gallery</a>
            <div class="relative group shrink-0">
                <a class="font-serif text-lg tracking-tight <%= activePage==='services' ? 'text-white border-b-2 border-white pb-1' : 'text-white/70 hover:text-white transition-colors' %> flex items-center gap-1" href="services.html">
                    Our Services
                    <svg class="w-3 h-3 mt-0.5 opacity-60 group-hover:opacity-100 transition-all group-hover:rotate-180 duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </a>
                <div class="absolute top-full left-0 mt-3 w-64 bg-[#FDFCFB] border border-stone-200 shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 translate-y-1 group-hover:translate-y-0 z-50">
