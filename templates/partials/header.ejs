                    <div class="px-4 py-3 border-b border-t border-stone-100"><span class="text-[9px] uppercase tracking-[0.2em] text-stone-400 font-sans font-semibold">Dangerous Game Hunting</span></div>
                </div>
            </div>
            <a class="font-serif text-lg tracking-tight <%= activePage==='about' ? 'text-white border-b-2 border-white pb-1' : 'text-white/70 hover:text-white transition-colors' %>" href="about.html">About Us</a>
            <a class="font-serif text-lg tracking-tight <%= activePage==='contact' ? 'text-white border-b-2 border-white pb-1' : 'text-white/70 hover:text-white transition-colors' %>" href="contact.html">Contact Us</a>
        </nav>
        <div class="flex items-center gap-3">
            <a href="contact.html#inquiry-form" class="hidden sm:inline-block bg-primary-container text-on-primary px-6 py-2 font-label-caps uppercase transition-opacity active:opacity-80">Join the Hunt</a>
