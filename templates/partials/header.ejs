        <a class="px-6 py-4 font-serif text-lg <%= activePage==='about' ? 'text-[#1B2B22] border-l-4 border-[#1B2B22] bg-stone-50' : 'text-stone-600 hover:bg-stone-50 border-l-4 border-transparent hover:border-stone-300 transition-all' %>" href="about.html">About Us</a>
