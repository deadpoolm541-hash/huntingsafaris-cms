<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="description" content="<%= page.meta.description %>"/>
<link rel="canonical" href="<%= global.canonicalBase %>/<%= activePage==='home' ? '' : activePage + '.html' %>"/>
<link rel="icon" type="image/webp" href="logo.webp">
<title><%= page.meta.title %></title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,400;0,700;1,400&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com"></script>
<script id="tailwind-config">
tailwind.config = {
  theme: {
    extend: {
      colors: {
        primary: '#1B2B22',
        'on-primary': '#FFFFFF',
        'primary-container': '#33503E',
        'on-primary-container': '#C2E8D0',
        secondary: '#52634D',
        'on-secondary': '#FFFFFF',
        'secondary-container': '#788E70',
        'on-secondary-container': '#F0F5EE',
        surface: '#FCFAF7',
        'on-surface': '#1B1C19',
        'surface-container': '#F0EEEB',
        'surface-dim': '#DDD9D5',
        outline: '#757874',
        'outline-variant': '#C4C8C0',
      },
      fontFamily: {
        serif: ['Noto Serif', 'Georgia', 'serif'],
        sans: ['Manrope', 'system-ui', 'sans-serif'],
      },
    },
  },
};
</script>
<style type="text/tailwindcss">
@layer utilities {
  .font-label-caps {
    font-family: 'Manrope', sans-serif;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.15em;
  }
}
</style>
<style>
*{scrollbar-width:thin;scrollbar-color:#888 transparent}
::-webkit-scrollbar{width:6px}
::-webkit-scrollbar-thumb{background-color:#888;border-radius:3px}
.mobile-overlay{opacity:0;pointer-events:none;transition:opacity .3s ease}
.mobile-overlay.active{opacity:1;pointer-events:auto}
.mobile-menu{transform:translateX(100%);transition:transform .3s ease}
.mobile-menu.active{transform:translateX(0)}
</style>
